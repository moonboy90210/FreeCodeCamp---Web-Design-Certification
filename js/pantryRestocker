function parseShipment(rawData) {
  const shipment = [];
  const seenSKUs = [];

  for (let i = 0; i < rawData.length; i++) {
    const splits = rawData[i].split("|");

    const sku = splits[0].trim();

    if(seenSKUs.includes(sku)) {
      continue;
    }

    seenSKUs.push(sku);

    //Create a new object with keys and the required properties.
    const item = {
      sku: sku,
      name: splits[1].trim(),
      qty: Number(splits[2]),
      expires: splits[3].trim(),
      zone: splits[4] ? splits[4].trim() : "general",

    };

    shipment.push(item);
  }

  return shipment;
}

