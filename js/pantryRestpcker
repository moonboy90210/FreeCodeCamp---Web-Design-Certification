const pantry = [
  { sku: "A10", name: "Tomatoes", qty: 4, expires: "2027-01-01", zone: "fridge" },
  { sku: "D43", name: "Pineapples", qty: 2, expires: "2020-01-01", zone: "general" }
];

const rawData = [
  "A10|Tomatoes|5|2027-01-01",
  "B21|Bananas|10|2027-01-01",
  "C32|Eggs|3|2027-01-01|fridge",
  "C32|Eggs|3|2027-01-01",
  "D43|Pineapples|0|2027-01-01",
  "E54|Peppers|-1|2027-01-01|fridge"
];

function parseShipment(rawData) {
	const shipment = [];

	for (let i = 0; i < rawData.length; i++) {
		const each = rawData[i];
		const splits = each.split("|");


		

		const sku = splits[0].trim();
		const name = splits[1].trim();
		const qty = Number(splits[2]);
		const expires = splits[3].trim();
		const zone = splits[4];

		if (!zone) {
			console.log("general");
		}

		shipment.push(sku, name, qty, expires, zone);

	}
	return shipment;
}

console.log(parseShipment(rawData));